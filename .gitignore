# ========== Fonts (downloaded binaries) ==========
# 这些是本地下载的字体资源，但 cdn/ 下的 css 和 js 保留
# cdn/fontawesome/webfonts/*.woff2   ← 保留 woff2（小且必要）
# cdn/fontawesome/webfonts/*.ttf     ← 排除（冗余大）
# cdn/lucide/lucide.min.js           ← 保留

cdn/fontawesome/webfonts/*.ttf
