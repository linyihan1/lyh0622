# lyh_唯品会评论情感分类项目 · 环境变量示例（复制为 .env 后填写真实值）
# lyh_注意：.env 必须加入 .gitignore，严禁提交到仓库

# ═══ 大模型服务（硅基流动 SiliconFlow） ═══
LLM_API_KEY=sk-your-siliconflow-api-key-here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

# ═══ 服务端口（实验指导书：学号后三位 225 → 端口 8225） ═══
PORT=8225

# ═══ MySQL 数据库（可选，本项目用 JSON 文件持久化） ═══
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=lyh_vipshop
